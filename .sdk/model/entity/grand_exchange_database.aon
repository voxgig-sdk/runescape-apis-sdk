on URL\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"total\":{\"description\":\"The total number of items in the category\",\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Successful response with items list\"}},\"securitySource\":\"unspecified\"}"
