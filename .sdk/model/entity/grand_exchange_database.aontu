                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/m=itemdb_rs/api/catalogue/items.json"
          q: {
            exist: [
              "alpha"
              "category"
              "page"
            ]
          }
          s: [
            {
              lit: "m=itemdb_rs"
            }
            {
              lit: "api"
            }
            {
              lit: "catalogue"
            }
            {
              lit: "items.json"
            }
          ]
