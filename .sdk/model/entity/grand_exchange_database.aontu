      h: "Last Config Update Runeday"
      n: "lastConfigUpdateRuneday"
      r: false
      sh: "The runedate when the database was last updated"
      t: "`$INTEGER`"
    }
    letter: {
      h: "Letter"
      n: "letter"
      r: false
      sh: "The first letter of an item"
      t: "`$STRING`"
    }
