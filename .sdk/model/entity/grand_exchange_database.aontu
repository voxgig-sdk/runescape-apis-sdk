  id: {
    field: "id"
    name: "id"
  }

  name: "grand_exchange_database"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /m=itemdb_rs/api/catalogue/items.json"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "alpha"
                or: "alpha"
                r: true
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "category"
